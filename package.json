{
  "name": "hackutd-scrabble",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bot.mjs",
    "start:prod": "node --env-file-if-exists=.env dist/bot.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "check:server": "tsx --env-file-if-exists=.env scripts/check-connection.ts",
    "verify:engine": "tsx scripts/verify-engine.ts",
    "test:live": "tsx --env-file-if-exists=.env src/index.ts --once",
    "provision:lab": "tsx scripts/provision-lab.ts",
    "public:lab": "tsx --env-file-if-exists=.env scripts/run-public-lab.ts",
    "live:report": "tsx scripts/live-report.ts",
    "live:merge": "tsx scripts/merge-live.ts"
  },
  "dependencies": {
    "spacetimedb": "2.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
